# Base URL of the NestJS API — no trailing slash, no /api/v1 prefix
# (the client adds it). In dev this matches the portless collabstr-api port.
EXPO_PUBLIC_API_URL=http://localhost:4417

# Sentry DSN (optional). Leave empty to skip Sentry entirely (init is gated
# on this var). With a DSN set under Expo Go the SDK runs JS-only — native
# crash handling needs a dev/EAS build.
EXPO_PUBLIC_SENTRY_DSN=
