NEXT_PUBLIC_API_URL=
API_URL=https://collabstr-api.localhost
# Set to 1 to show demo credentials on the admin login page (DEV ONLY).
SHOW_DEMO_CREDS=
# Sentry error monitoring (optional — everything is a no-op when unset).
# Browser-side DSN (inlined at build time):
NEXT_PUBLIC_SENTRY_DSN=
# Server/edge-side DSN (falls back to NEXT_PUBLIC_SENTRY_DSN if unset):
SENTRY_DSN=
