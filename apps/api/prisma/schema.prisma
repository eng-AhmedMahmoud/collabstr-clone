generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  brand
  creator
  admin
  superadmin
}

enum Platform {
  instagram
  tiktok
  youtube
  ugc
}

enum Category {
  Fashion
  Beauty
  Travel
  Fitness
  Food
  Lifestyle
  Tech
  Gaming
  Music
  Family
  Comedy
  Pets
}

enum OrderStatus {
  pending_payment
  awaiting_creator
  in_progress
  submitted
  revision_requested
  approved
  released
  cancelled
  disputed
}

enum CampaignStatus {
  draft
  open
  closed
}

enum ApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum NotificationKind {
  order_update
  new_message
  new_application
  payment
  system
}

// Double-entry-ish escrow ledger. The platform NEVER holds funds itself —
// money lives at a licensed PSP (Tap Payments); these rows mirror movements
// there via providerRef. Invariant per fully-closed order:
//   charge - refund - payout - commission = 0
enum LedgerEntryType {
  charge      // brand paid: order.amount + order.serviceFee into PSP escrow
  refund      // full charge returned to brand (cancellation of a paid order)
  payout      // order.amount released to creator
  commission  // order.serviceFee retained by the platform
  adjustment  // manual correction (reconciliation follow-up)
}

enum PaymentProviderKind {
  mock // dev/demo gateway — instant success, no real money
  tap  // Tap Payments (KSA-licensed PSP) — pending sandbox due diligence
}

// Saudi advertising-licence (Mawthooq / موثوق, issued by GAMR) verification state
// for a creator. Required before a creator can take paid orders — firms face
// fines up to SAR 5M for contracting unlicensed advertisers.
enum MawthooqStatus {
  none        // never submitted
  pending     // submitted, awaiting admin review
  verified    // licence confirmed valid
  rejected    // licence invalid / mismatched
  expired     // was verified, licence end-date passed
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  // Null for social-login-only accounts (Google/Apple) — they have no password.
  passwordHash    String?
  name            String
  role            Role
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  emailVerifiedAt DateTime?
  bannedAt        DateTime?
  // Preferred UI locale. Drives notification copy + initial cookie on login.
  // Null means "follow the request" (Accept-Language / cookie / default).
  locale          String?

  brandProfile    BrandProfile?
  creatorProfile  CreatorProfile?
  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]
  notifications   Notification[]
  savedCreators   SavedCreator[]
  reviewsLeft     Review[]         @relation("ReviewsLeft")
  threadsAsBrand  Thread[]         @relation("ThreadBrand")
  threadsAsCreator Thread[]        @relation("ThreadCreator")
  messages        Message[]
  campaigns       Campaign[]       @relation("CampaignBrand")
  ordersAsBrand   Order[]          @relation("OrderBrand")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  provider          String // "google" | "apple"
  providerAccountId String // provider's stable user id ("sub" claim)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model BrandProfile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  brandName   String
  website     String?
  industry    String?
  about       String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreatorProfile {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String         @unique
  username        String         @unique
  headline        String
  bio             String
  city            String
  country         String
  coverUrl        String?
  startingPrice   Int            @default(50)
  rating          Float          @default(5)
  reviewsCount    Int            @default(0)
  platforms       Platform[]
  categories      Category[]
  badges          String[]
  followersIg     Int?
  followersTt     Int?
  followersYt     Int?
  avgViews        Int?
  engagement      Float?
  audience        Json?
  portfolio       String[]
  isAvailable     Boolean        @default(true)

  // Mawthooq advertising-licence verification (GAMR). See MawthooqStatus.
  mawthooqStatus       MawthooqStatus @default(none)
  mawthooqLicenseNo    String?
  mawthooqSubmittedAt  DateTime?
  mawthooqVerifiedAt   DateTime?
  mawthooqExpiresAt    DateTime?
  mawthooqReviewNote   String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  packages        Package[]
  savedBy         SavedCreator[]
  reviewsReceived Review[]       @relation("ReviewsReceived")
  applications    Application[]
  orders          Order[]        @relation("OrderCreator")
  threadsAsCreator Thread[]      @relation("ThreadCreatorProfile")

  @@index([username])
  // Discovery browse: default sort + price filter of the public creators list.
  @@index([rating(sort: Desc), reviewsCount(sort: Desc)])
  @@index([startingPrice])
}

model Package {
  id           String         @id @default(cuid())
  creator      CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId    String
  title        String
  description  String?
  price        Int
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orders       Order[]
  @@index([creatorId])
}

model SavedCreator {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  createdAt DateTime       @default(now())

  @@unique([userId, creatorId])
}

model Campaign {
  id              String         @id @default(cuid())
  brand           User           @relation("CampaignBrand", fields: [brandId], references: [id], onDelete: Cascade)
  brandId         String
  title           String
  description     String
  budgetMin       Int
  budgetMax       Int
  platforms       Platform[]
  categories      Category[]
  creatorsNeeded  Int            @default(1)
  deadline        DateTime?
  status          CampaignStatus @default(open)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  applications    Application[]
  @@index([brandId, status])
}

model Application {
  id         String            @id @default(cuid())
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  creator    CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId  String
  price      Int
  pitch      String
  status     ApplicationStatus @default(pending)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([campaignId, creatorId])
  @@index([campaignId, status])
}

model Order {
  id           String       @id @default(cuid())
  brand        User         @relation("OrderBrand", fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  creator      CreatorProfile @relation("OrderCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId    String
  package      Package      @relation(fields: [packageId], references: [id])
  packageId    String
  brief        String
  amount       Int
  serviceFee   Int          @default(0)
  status       OrderStatus  @default(pending_payment)
  deadline     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  events       OrderEvent[]
  deliveries   Delivery[]
  review       Review?
  ledger       LedgerEntry[]

  @@index([brandId, status])
  @@index([creatorId, status])
}

model OrderEvent {
  id         String       @id @default(cuid())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  status     OrderStatus
  // Structured audit trail: who moved the order, from where. Legacy rows
  // (pre-ledger) have all of these null and encode admin actions via the
  // "[ADMIN]" note prefix — AdminService.auditLog() matches both.
  fromStatus OrderStatus?
  actorId    String?
  actorRole  String?
  meta       Json?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

// One row per money movement at the PSP. amount is in whole SAR (matches
// Order.amount / serviceFee). orderId is optional so manual adjustments can
// exist without an order, and rows survive order deletion (SetNull).
model LedgerEntry {
  id          String              @id @default(cuid())
  order       Order?              @relation(fields: [orderId], references: [id])
  orderId     String?
  type        LedgerEntryType
  amount      Int
  currency    String              @default("SAR")
  provider    PaymentProviderKind @default(mock)
  providerRef String?
  actorId     String?
  meta        Json?
  createdAt   DateTime            @default(now())

  @@index([orderId])
  @@index([type, createdAt])
}

// Raw inbound PSP webhook log. Persisted BEFORE processing so replays are
// idempotent (@@unique dedupe) and failures stay debuggable (error column).
model WebhookEvent {
  id             String              @id @default(cuid())
  provider       PaymentProviderKind
  eventId        String
  eventType      String
  payload        Json
  signatureValid Boolean             @default(false)
  processedAt    DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
}

// Daily (03:00 Asia/Riyadh) escrow reconciliation snapshot:
// escrowOutstanding (from ledger) vs expected escrow (from open orders).
// ok == false (delta != 0) means the ledger and the order book disagree.
model ReconciliationRun {
  id                String   @id @default(cuid())
  rangeStart        DateTime
  rangeEnd          DateTime
  moneyIn           Int
  refunds           Int
  payouts           Int
  commission        Int
  escrowOutstanding Int
  delta             Int
  ok                Boolean
  detail            Json?
  createdAt         DateTime @default(now())
}

model Delivery {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  url       String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Review {
  id         String         @id @default(cuid())
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String         @unique
  author     User           @relation("ReviewsLeft", fields: [authorId], references: [id])
  authorId   String
  creator    CreatorProfile @relation("ReviewsReceived", fields: [creatorId], references: [id])
  creatorId  String
  rating     Int
  text       String
  createdAt  DateTime       @default(now())

  @@index([creatorId])
}

model Thread {
  id              String          @id @default(cuid())
  brand           User            @relation("ThreadBrand", fields: [brandId], references: [id], onDelete: Cascade)
  brandId         String
  creator         User            @relation("ThreadCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  creatorUserId   String
  creatorProfile  CreatorProfile? @relation("ThreadCreatorProfile", fields: [creatorProfileId], references: [id])
  creatorProfileId String?
  lastMessageAt   DateTime        @default(now())
  createdAt       DateTime        @default(now())

  messages        Message[]
  @@unique([brandId, creatorUserId])
  @@index([brandId])
  @@index([creatorUserId])
}

model Message {
  id        String   @id @default(cuid())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotificationKind
  // Bilingual payload: { en: "...", ar: "..." } for system-generated copy.
  // Older single-language rows (legacy from before the bilingual switch) are
  // returned as-is and the service layer picks .en as fallback.
  title     Json
  body      Json?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}
